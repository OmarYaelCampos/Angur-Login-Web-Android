<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="18dp"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/brand_angur"
                android:textColor="@color/angur_ink"
                android:textSize="29sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/brand_gestion"
                android:textColor="#D6A06C"
                android:textSize="18sp" />

            <LinearLayout
                android:id="@+id/formView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/welcome"
                    android:textColor="@color/angur_ink"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="22dp"
                    android:text="@string/instruction"
                    android:textColor="@color/angur_muted"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/identifierLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/identifierField"
                    android:text="@string/identifier_label"
                    android:textColor="@color/angur_ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/identifierField"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="7dp"
                    android:layout_marginBottom="18dp"
                    android:background="@drawable/login_input"
                    android:hint="@string/identifier_hint"
                    android:inputType="textEmailAddress"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:singleLine="true"
                    android:textColor="@color/angur_ink"
                    android:textColorHint="#8A9997"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:labelFor="@id/passwordField"
                    android:text="@string/password_label"
                    android:textColor="@color/angur_ink"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/passwordField"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="7dp"
                    android:background="@drawable/login_input"
                    android:hint="@string/password_hint"
                    android:inputType="textPassword"
                    android:paddingStart="13dp"
                    android:paddingEnd="13dp"
                    android:singleLine="true"
                    android:textColor="@color/angur_ink"
                    android:textColorHint="#8A9997"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/messageView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:contentDescription="Mensaje de inicio de sesión"
                    android:textColor="@color/angur_error"
                    android:textSize="13sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/loginButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/login_button"
                    android:text="@string/login_button"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/menuView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/menu_title"
                    android:textColor="@color/angur_ink"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/menuInitial"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginTop="16dp"
                    android:background="@color/angur_mint"
                    android:gravity="center"
                    android:textColor="@color/angur_ink"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/menuName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="9dp"
                    android:textColor="@color/angur_ink"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/menuRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:background="@color/angur_mint"
                    android:paddingStart="12dp"
                    android:paddingTop="6dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="6dp"
                    android:textColor="@color/angur_ink"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="10dp"
                    android:text="@string/menu_subtitle"
                    android:textColor="@color/angur_muted"
                    android:textSize="13sp" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="3"
                    android:useDefaultMargins="true">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="82dp"
                        android:layout_columnWeight="1"
                        android:background="@drawable/login_card"
                        android:clickable="false"
                        android:focusable="false"
                        android:gravity="center"
                        android:padding="10dp"
                        android:text="@string/menu_products"
                        android:textColor="@color/angur_ink"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="82dp"
                        android:layout_columnWeight="1"
                        android:background="@drawable/login_card"
                        android:clickable="false"
                        android:focusable="false"
                        android:gravity="center"
                        android:padding="10dp"
                        android:text="@string/menu_inventory"
                        android:textColor="@color/angur_ink"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="82dp"
                        android:layout_columnWeight="1"
                        android:background="@drawable/login_card"
                        android:clickable="false"
                        android:focusable="false"
                        android:gravity="center"
                        android:padding="10dp"
                        android:text="@string/menu_clients"
                        android:textColor="@color/angur_ink"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="82dp"
                        android:layout_columnWeight="1"
                        android:background="@drawable/login_card"
                        android:clickable="false"
                        android:focusable="false"
                        android:gravity="center"
                        android:padding="10dp"
                        android:text="@string/menu_quotes"
                        android:textColor="@color/angur_ink"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="82dp"
                        android:layout_columnWeight="1"
                        android:background="@drawable/login_card"
                        android:clickable="false"
                        android:focusable="false"
                        android:gravity="center"
                        android:padding="10dp"
                        android:text="@string/menu_sales"
                        android:textColor="@color/angur_ink"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="82dp"
                        android:layout_columnWeight="1"
                        android:background="@drawable/login_card"
                        android:clickable="false"
                        android:focusable="false"
                        android:gravity="center"
                        android:padding="10dp"
                        android:text="@string/menu_reports"
                        android:textColor="@color/angur_ink"
                        android:textStyle="bold" />
                </GridLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/login_card"
                    android:padding="12dp"
                    android:text="@string/menu_note"
                    android:textColor="@color/angur_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
